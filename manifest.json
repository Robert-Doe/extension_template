{
  "manifest_version": 3,
  "name": "Extension Template",
  "version": "0.1.0",
  "description": "A minimal cross-browser WebExtension starter.",
  "action": {
    "default_title": "Extension Template",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": []
}
